# Application
APP_NAME=灵枢智能工单协同调度平台
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Database: use sqlite locally, PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./data/lingshu.db
# DATABASE_URL=postgresql+asyncpg://lingshu:lingshu@localhost:5432/lingshu
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Infrastructure
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=workorder-media
MINIO_SECURE=false
MEDIA_STORAGE_MODE=auto
LOCAL_MEDIA_DIR=data/media
MAX_UPLOAD_BYTES=52428800

# Cache: L1 process memory, L2 Redis
CACHE_L1_TTL_SECONDS=5
CACHE_L2_TTL_SECONDS=30
CACHE_TTL_JITTER_RATIO=0.2
CACHE_MAX_L1_ITEMS=2048
AGENT_PIPELINE=intent-agent,dispatch-agent,order-flow-agent,credit-agent,patrol-agent
AI_ENRICH_RATE_LIMIT=20/m

# Circuit breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30

# AI adapter: fallback keeps core workflow available without an external model
AI_MODE=fallback
AI_ASYNC_ENABLED=true
WHISPER_MODEL=base
YOLO_MODEL=yolov8n.pt
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=qwen
LLM_FALLBACK_API_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
